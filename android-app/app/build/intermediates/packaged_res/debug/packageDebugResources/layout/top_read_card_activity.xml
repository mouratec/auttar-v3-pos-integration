<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_transaction.xml
    Tela fullscreen de transação – Brand Getnet/Auttar
    Paleta: #D32F2F (vermelho Getnet), #B71C1C (dark red), #FFFFFF, #F5F5F5
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D32F2F"
    android:fitsSystemWindows="true">

    <!-- ── Fundo decorativo: círculo grande desfocado ── -->
    <View
        android:id="@+id/bgCircle"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:background="@drawable/shape_bg_circle"
        android:alpha="0.12"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp" />

    <!-- ── Logo Getnet topo ── -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Substituir por ImageView com logo real se disponível -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Getnet"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtPaymentType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crédito"
            android:textColor="#FFCDD2"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Card branco central (conteúdo principal) ── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/top_cancel_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ── Valor da transação ── -->
            <TextView
                android:id="@+id/labelAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VALOR DA TRANSAÇÃO"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:paddingTop="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textColor="#B71C1C"
                android:textSize="42sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="-0.02"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/labelAmount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ── Divisor ── -->
            <View
                android:id="@+id/divider"
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:background="#D32F2F"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/txtAmount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ── Área de animação de cartão ── -->
            <FrameLayout
                android:id="@+id/iconArea"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Anel de pulso (visível em estado de aguardar cartão) -->
                <View
                    android:id="@+id/pulseRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_pulse_ring"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Ícone cartão/NFC -->
                <ImageView
                    android:id="@+id/iconCard"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:contentDescription="Cartão"
                    android:src="@drawable/ic_card_vector"
                    android:tint="#D32F2F"
                    android:visibility="visible" />

                <!-- Ícone sucesso -->
                <ImageView
                    android:id="@+id/iconSuccess"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_success_vector"
                    android:tint="#2E7D32"
                    android:contentDescription="Aprovado"
                    android:visibility="gone" />

                <!-- Ícone erro -->
                <ImageView
                    android:id="@+id/iconError"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_error_vector"
                    android:tint="#B71C1C"
                    android:contentDescription="Erro"
                    android:visibility="gone" />

                <!-- Ícone PIN/senha -->
                <ImageView
                    android:id="@+id/iconPin"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_pin_vector"
                    android:tint="#424242"
                    android:contentDescription="Senha"
                    android:visibility="gone" />

                <!-- Ícone Pix -->
                <ImageView
                    android:id="@+id/iconPix"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_pix"
                    android:tint="#009688"
                    android:contentDescription="Pix"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- ── ProgressBar ── -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminateTint="#D32F2F"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/iconArea"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:visibility="visible" />

            <!-- ── Mensagem de status ── -->
            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Aguardando cartão..."
                android:textColor="#424242"
                android:textSize="16sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/progressBar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="0.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- ── Botão Cancelar ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/top_cancel_button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="CANCELAR"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:letterSpacing="0.08"
        android:textStyle="bold"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:backgroundTint="#B71C1C"
        app:cornerRadius="26dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
